###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Empty falls back to <project>/docs/data-pack (app.default_data_pack_dir): .env cannot use %kernel.project_dir%
DATA_PACK_DIR=

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###
